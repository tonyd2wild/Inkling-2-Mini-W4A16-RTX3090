+def _rms_norm_torch(
+    x: torch.Tensor, weight: torch.Tensor, eps: float
+) -> torch.Tensor:
+    """RMSNorm over the last dim in fp32, rounded once (as the vLLM C kernel).
+    `weight` broadcasts against `x` (e.g. one row per layer)."""
+    xf = x.float()
+    xf = xf * torch.rsqrt(xf.square().mean(-1, keepdim=True) + eps)
+    return (xf * weight.float()).to(x.dtype)
+
+
+def _rope_inplace_torch(
+    positions: torch.Tensor,
+    x: torch.Tensor,
+    head_size: int,
+    cos_sin_cache: torch.Tensor,
+    is_neox: bool,
+) -> None:
+    """In-place RoPE on `x` [tokens, heads * head_size], same layout as
+    `ops.rotary_embedding(positions, x, None, ...)`."""
+    num_tokens = x.shape[0]
+    heads = x.view(num_tokens, -1, head_size)
+    cos_sin = cos_sin_cache.index_select(0, positions)
+    rot_dim = cos_sin.shape[-1]
+    cos, sin = cos_sin.float().chunk(2, dim=-1)
+    cos, sin = cos.unsqueeze(1), sin.unsqueeze(1)
+    rot = heads[..., :rot_dim].float()
+    if is_neox:
+        x1, x2 = rot.chunk(2, dim=-1)
+    else:
+        x1, x2 = rot[..., 0::2], rot[..., 1::2]
+    o1 = x1 * cos - x2 * sin
+    o2 = x2 * cos + x1 * sin
+    if is_neox:
+        out = torch.cat((o1, o2), dim=-1)
+    else:
+        out = torch.stack((o1, o2), dim=-1).flatten(-2)
+    heads[..., :rot_dim].copy_(out.to(x.dtype))
 
 
